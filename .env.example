# Copy to .env and fill in. Never commit the real .env.

# Google Gemini API key — Stage-2 reasoning agent.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Check the current cheapest/fastest "Flash" tier model name in Google AI Studio
# before the demo — Google renames/retires these often. This is just a default.
GEMINI_MODEL=gemini-3.6-flash

# Simulated-time speedup: 1 real second = SIM_SPEED simulated seconds.
# Higher = dead-zone crossings resolve faster on screen for a live demo.
SIM_SPEED=12

PORT=8080
