# Copy to .env and fill in. Never commit the real .env.

# Groq API key — Stage-2 reasoning agent (fast, generous free-tier inference over
# open-weight models). Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Check the current recommended model at https://console.groq.com/docs/models
# before the demo — this list changes over time. This is just a default.
GROQ_MODEL=openai/gpt-oss-20b

# Simulated-time speedup: 1 real second = SIM_SPEED simulated seconds.
# Higher = dead-zone crossings resolve faster on screen for a live demo, but also
# means more riders can need a Stage-2 call in the same real-world minute — kept
# low by default to stay comfortably under Groq's free-tier tokens-per-minute limit.
SIM_SPEED=4

PORT=8080
